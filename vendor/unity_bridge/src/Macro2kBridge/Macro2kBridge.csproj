<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Macro2k Unity Bridge — generic BepInEx 5 plugin (Mono Unity games, 2018.3+).
    Build:  dotnet build -c Release  (output is copied to vendor/unity_bridge/plugin)
    Unity DLLs are compile-time references only; point UnityManagedDir at any
    Unity game's <Game>_Data/Managed folder:
      dotnet build -c Release -p:UnityManagedDir="D:\Game\Game_Data\Managed"
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Macro2kBridge</AssemblyName>
    <RootNamespace>Macro2k.UnityBridge</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <UnityManagedDir Condition="'$(UnityManagedDir)' == ''">D:\Neowiz\Browndust2\BrownDust2_10000002\BrownDust II_Data\Managed</UnityManagedDir>
    <BepInExCoreDir>$(MSBuildThisFileDirectory)..\..\bepinex5_x64\BepInEx\core</BepInExCoreDir>
    <VendorPluginDir>$(MSBuildThisFileDirectory)..\..\plugin</VendorPluginDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(UnityManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(UnityManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityEngine.Input (legacy Input manager) for the key patches. The Input
         System is used through reflection, so it is not referenced. -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(UnityManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToVendor" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(VendorPluginDir)" />
  </Target>
</Project>
